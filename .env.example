# Copy to .env, then export these variables into BOTH API and worker processes.
# Windows quickstart script loads .env automatically.
DATA_DIR=./data
DATABASE_URL=sqlite:///data/state.db
CORS_ORIGINS=http://localhost:5173
SANDBOX_IMAGE=proof-analyst-sandbox:local
# Optional Windows WSL engine; leave empty when using native Docker CLI.
# Set to HacknexTest for the dedicated test engine installed on this machine.
DOCKER_WSL_DISTRO=
DOCKER_EXECUTABLE=
# deterministic supports exact aggregate questions without credentials.
# openai uses structured planning; select a model available to your account.
PLANNER=deterministic
OPENAI_MODEL=
OPENAI_API_KEY=
